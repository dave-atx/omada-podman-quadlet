[Unit]
Description=SFTP Container
After=caddy-proxy.service
Requires=caddy-proxy.service

[Container]
Image=docker.io/drakkan/sftpgo:v2-alpine-slim
AutoUpdate=registry
ContainerName=sftpgo
Volume=sftp-home:/var/lib/sftpgo:U
Volume=sftp-data:/srv/sftpgo:U
Network=caddy.network
Label="caddy=sftpgo.your-domain-here.example.com"
Label="caddy.reverse_proxy={{upstreams 8080}}"

[Service]
Restart=always

[Install]
WantedBy=default.target
